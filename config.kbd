;; Setup only for Thinkpad buildin keyboard
(defcfg
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

;; These are INPUT keycodes, not output characters.
;; The Sweep must send these same codes from its 34 positions.
(defsrc
  tab q w e r t y u i o p
  caps a s d f g h j k l ;
  lsft z x c v b n m , . /
  lctl lalt    spc    ralt
)

(defalias
  ;; Home-row mods
  d (tap-hold-press 180 180 s lsft)
  f (tap-hold-press 180 180 t lctl)

  j (tap-hold-press 180 180 n rctl)
  k (tap-hold-press 180 180 e rsft)

  ;; Navigation
  nav (tap-hold-press 180 180 esc (layer-while-held navigation))
)

(deflayer base
  tab   q  w  f  p  b       j  l  u  y  ;
  @nav  a  r  @d @f g       m  @j @k i  o
  lsft  x  c  d  v  z       k  h  ,  .  /
  lctl         lalt    spc    ralt
)

;; Layer 4: Navigation (mouse layer removed)
(deflayer navigation
  XX XX XX XX XX XX    XX pgdn pgup XX XX
  XX XX XX XX XX XX    left down up right XX
  XX XX XX XX XX XX    XX end home XX XX
               XX XX XX XX
)
