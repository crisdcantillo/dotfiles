output eDP-1 resolution 1920x1200
output eDP-1 scale 1.25

exec pipewire
exec pipewire-pulse
exec wireplumber
exec_always swaybg -i ~/.config/sway/wallpaper.jpg -m fill

set $mod Mod4

set $term foot
set $menu bemenu-run    \
    --line-height 24    \
    --hp 12             \
    --fb '#323232'      \
    --nb '#323232'      \
    --tf '#ffffff'      \
    --tb '#323232'      \
    --hf '#ffffff'      \
    --hb '#323232'


# SHORTCUTS
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 10%-

bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# WORKSPACES
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up focus up
bindsym $mod+Down focus down

bindsym $mod+Return exec $term
bindsym $mod+Space exec $menu
bindsym $mod+q kill

# Remove default top blue status bar
default_border pixel 0

bar {
    position top
    height 24

    status_command ~/.config/sway/status.sh

    colors {
        statusline #ffffff
        background #323232
        focused_workspace  #d0d0d0 #d0d0d0 #262626
        active_workspace   #323232 #323232 #ffffff
        inactive_workspace #323232 #323232 #5c5c5c
    }
}

# DEVICES
input type:keyboard {
    xkb_layout us
    xkb_variant colemak_dh
}

input type:touchpad {
    tap enabled
    tap_button_map lrm
    natural_scroll enabled
    scroll_method two_finger
}
